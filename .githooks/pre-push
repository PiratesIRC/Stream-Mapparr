#!/usr/bin/env bash
# Standard pre-push gate. GENERATED by _shared/tools/generate_hooks.py; edit
# the generator, not this file. Audits every ref about to be pushed with the
# workspace publish audit and proves the repository's deny rules fire. A
# non-zero audit, or an audit that prints NOTHING, aborts the push.
#
# To push anyway, having read every finding:  git push --no-verify
set -u
ROOT="$(git rev-parse --show-toplevel)"
AUDIT="$ROOT/../.claude/skills/pre-publish-audit/audit_publish.py"
VERIFY="$ROOT/../.claude/skills/pre-publish-audit/verify_deny_rules.py"
RULES="$ROOT/.publish-audit.json"
PY="${PYTHON:-python}"; command -v "$PY" >/dev/null 2>&1 || PY=python3
REMOTE_NAME="${1:-}"
REMOTE_URL="${2:-}"

if [ ! -f "$AUDIT" ]; then
  echo "[pre-push] publish audit not found at $AUDIT; refusing to push blind."
  exit 1
fi

# A PRIVATE remote may receive development history. The allowance is an
# explicit private_remotes list in .publish-audit.json matched against the
# remote URL; an unrecognised remote is audited. Do not add a public remote
# there to silence a finding.
# The interpreter must be a real Python before anything below trusts its exit
# code: a stub that exits 0 and prints nothing would otherwise pass every gate.
if [ "$("$PY" -c 'import sys; print(sys.version_info[0])' 2>/dev/null)" != "3" ]; then
  echo "[pre-push] $PY is not a Python 3 interpreter; refusing to push blind."
  exit 1
fi

if [ -f "$RULES" ] && [ -n "$REMOTE_URL" ]; then
  # The skip is honoured only when the helper prints its marker line, never on
  # a bare exit 0, so a broken helper cannot silence the audit.
  private_out="$("$PY" "$ROOT/scripts/release_config.py" --private-remote "$RULES" "$REMOTE_URL" 2>&1 </dev/null)"
  private_rc=$?
  marker="$(printf '%s\n' "$private_out" | grep -c 'PRIVATE-REMOTE-MATCH' || true)"
  if [ "$private_rc" -eq 0 ] && [ "${marker:-0}" -gt 0 ]; then
    printf '%s\n' "$private_out"
    echo "[pre-push] $REMOTE_NAME is a private remote by explicit rule: content audit skipped."
    exit 0
  fi
fi

if [ -f "$RULES" ]; then
  echo "[pre-push] proving the deny rules fire"
  if ! "$PY" "$VERIFY" --rules "$RULES"; then
    echo "[pre-push] a deny rule is dead or untestable; fix .publish-audit.json first."
    exit 1
  fi
else
  echo "[pre-push] no .publish-audit.json: only built-in patterns run. The deny list is the half that catches real leaks."
fi

status=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac   # all-zero sha = deletion
  echo "[pre-push] auditing $local_sha"
  # </dev/null so the audit cannot consume the remaining ref lines on stdin.
  out="$("$PY" "$AUDIT" --ref "$local_sha" --repo "$ROOT" 2>&1 </dev/null)"; rc=$?
  printf '%s\n' "$out"
  if [ -z "$out" ]; then
    echo "[pre-push] the audit produced no output, so it did not run. Refusing to push blind."
    status=1; continue
  fi
  # grep -c, never grep -q: under pipefail grep -q SIGPIPEs its feeder and the
  # gate reads FALSE precisely when there are findings (measured here).
  findings="$(printf '%s\n' "$out" | grep -c '^\[' || true)"
  if [ "$rc" -ne 0 ] || [ "${findings:-0}" -gt 0 ]; then status=1; fi
done

if [ "$status" -ne 0 ]; then
  echo
  echo "[pre-push] PUSH ABORTED. Read every finding above. If a credential is in there, ROTATE IT FIRST."
  exit 1
fi
echo "[pre-push] audit clean"
exit 0
